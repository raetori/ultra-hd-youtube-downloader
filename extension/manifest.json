{
  "manifest_version": 3,
  "name": "CosmoGrav",
  "short_name": "CosmoGrav",
  "version": "1.7.1",
  "description": "Send any video, image, file or YouTube link to CosmoGrav on your Mac. Premiere-ready H.264/AAC MP4s, no accounts, no tracking.",
  "homepage_url": "https://www.creationofcosmos.com",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CosmoGrav",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content/common.js",
        "content/youtube.js"
      ],
      "css": [
        "content/cosmograv.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "pages/settings.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open CosmoGrav"
    },
    "send-tab": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Download this page with CosmoGrav"
    },
    "grab-page": {
      "description": "Grab all media on this page"
    }
  }
}
